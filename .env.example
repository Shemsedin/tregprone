# --- Common ---
NODE_ENV=development
TZ=Europe/Tirane

# --- Web (apps/web) ---
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
PUBLIC_DEFAULT_LOCALE=sq-AL
PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=REPLACE_ME
PUBLIC_PLAUSIBLE_DOMAIN=
WEB_PORT=3000
WEB_HOST=0.0.0.0
SESSION_COOKIE_DOMAIN=localhost
SESSION_COOKIE_SECURE=false

# --- API (apps/api) ---
API_PORT=4000
API_HOST=0.0.0.0
API_LOG_LEVEL=debug
DATABASE_URL=postgresql://treg:treg@localhost:5432/treg?schema=public
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
CORS_ORIGINS=http://localhost:3000

# --- OAuth ---
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:4000/v1/auth/oauth/google/callback

# --- Mail (Resend in prod, MailHog locally) ---
MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Treg Prone <noreply@tregprone.dev>"
RESEND_API_KEY=

# --- Storage (S3-compatible; MinIO for local dev) ---
BLOB_ENDPOINT=http://localhost:9002
BLOB_ACCESS_KEY=minioadmin
BLOB_SECRET_KEY=minioadmin
BLOB_PUBLIC_CONTAINER=images-public
BLOB_PRIVATE_CONTAINER=images-private
BLOB_PUBLIC_BASE_URL=http://localhost:9002/images-public

# --- Telemetry (OpenTelemetry OTLP) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
